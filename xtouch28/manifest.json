{
  "manifest_version": 3,
  "name": "XTouch CYD Cloud setup",
  "version": "1.5",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": ["https://bambulab.com/*", "https://*.bambulab.com/*", "https://bambulab.cn/*", "https://*.bambulab.cn/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
